{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Core profile data for candidates and employers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["candidate", "employer"] },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "type": "string" } },
        "experienceLevel": { "type": "string", "enum": ["junior", "mid", "senior", "lead"] },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "linkedinUrl": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "desiredSkills": { "type": "array", "items": { "type": "string" } },
        "mindset": { "type": "string" },
        "culture": { "type": "string" },
        "style": { "type": "string" },
        "desiredSalary": { "type": "string" },
        "companySize": { "type": "string" },
        "industry": { "type": "string" },
        "mission": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "displayName"]
    },
    "JobPost": {
      "title": "Job Posting",
      "description": "Job offer details created by employers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employerUid": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "companyLogo": { "type": "string" },
        "companySize": { "type": "string" },
        "industry": { "type": "string" },
        "companyMission": { "type": "string" },
        "description": { "type": "string" },
        "requiredSkills": { "type": "array", "items": { "type": "string" } },
        "requiredLanguages": { "type": "array", "items": { "type": "string" } },
        "experienceLevel": { "type": "string", "enum": ["junior", "mid", "senior", "lead"] },
        "salaryRange": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "mindset": { "type": "string" },
        "culture": { "type": "string" },
        "style": { "type": "string" },
        "contractDetails": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employerUid", "title", "companyName"]
    },
    "Swipe": {
      "title": "Swipe Action",
      "description": "Record of a swipe interaction",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string" },
        "toId": { "type": "string" },
        "type": { "type": "string", "enum": ["candidate-to-job", "employer-to-candidate"] },
        "direction": { "type": "string", "enum": ["like", "pass"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "toId", "type", "direction"]
    },
    "Match": {
      "title": "Match",
      "description": "A mutual connection between a candidate and a job posting",
      "type": "object",
      "properties": {
        "candidateUid": { "type": "string" },
        "jobPostId": { "type": "string" },
        "employerUid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["candidateUid", "jobPostId", "employerUid"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation between a candidate and an employer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "number" },
        "candidateName": { "type": "string" },
        "candidatePhoto": { "type": "string" },
        "employerName": { "type": "string" },
        "employerPhoto": { "type": "string" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "A single message within a chat",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "meetingRequest": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "startTime": { "type": "number" },
            "meetLink": { "type": "string" }
          }
        }
      }
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/jobs/{jobId}": {
      "schema": "JobPost",
      "description": "Job posting documents"
    },
    "/swipes/{swipeId}": {
      "schema": "Swipe",
      "description": "All swipe interactions"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Mutual matches between candidates and employers"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat session between users"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages in a chat"
    }
  }
}
