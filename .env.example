# Port for the API server (also serves the built frontend in production).
PORT=3001

# Required for native builds so the installed app can reach the hosted API.
# Leave blank for same-origin web deployments.
VITE_API_BASE_URL=https://api.your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://localhost,capacitor://localhost

# Long random value used to sign OAuth state and login sessions.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Create these in the LinkedIn Developer Portal and register the exact HTTPS callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain.com/api/auth/linkedin/callback

# Restricted partner features. Enable only after LinkedIn Talent Solutions approval.
LINKEDIN_TALENT_SYNC_ENABLED=false
LINKEDIN_JOB_POSTING_TOKEN=

# Path to the JSON database file (defaults to ./data/db.json).
# DB_PATH=./data/db.json
