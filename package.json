{
  "name": "jobmatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tinder-style mutual matching between candidates and jobs",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.js\" \"vite --host 0.0.0.0 --port 3000\"",
    "mobile": "node server/mobile-launcher.js",
    "expo:mobile": "node server/expo-launcher.js",
    "build": "vite build",
    "build:web:production": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --test server/*.test.js",
    "seed:reset": "rm -f data/db.json && echo 'Database reset. It will be re-seeded on next server start.'",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:android": "npm run mobile:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "express": "^4.21.2",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
